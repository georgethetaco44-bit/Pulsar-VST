{
  "version": 1,
  "name": "Feedback Guitar",
  "prompt": "a plucked string fed by its own amp: turn up the feedback and the note sustains, then blooms into a screaming harmonic like a guitar held against the speaker",
  "macros": [
    {
      "label": "Feedback",
      "default": 0.15
    },
    {
      "label": "Pick Tone",
      "default": 0.55
    },
    {
      "label": "Harmonic",
      "default": 0.4
    },
    {
      "label": "Gain",
      "default": 0.55
    },
    {
      "label": "Vibrato",
      "default": 0.3
    },
    {
      "label": "Room",
      "default": 0.3
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "noise",
        "phys_string:0"
      ],
      [
        "phys_string:0",
        "fx_sat"
      ],
