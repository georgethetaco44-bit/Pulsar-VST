  "code": {
    "init": "// pick: a short noise burst; vibrato starts from zero on each note\npk = 1; vt = 0; s = 0;\nk = 1 / log(1000);",
    "voice": "// the pick burst (~15 ms), louder with velocity\npk *= 0.9986;\nex = noise() * pk * pk * (0.3 + 0.5 * vel);\n// delayed vibrato, then the string an octave up below 48 Hz (its lowest note)\nvt = min(1, vt + 1.5 / srate);\nvph += 5.5 / srate; vph -= floor(vph);\nsf = freq * (1 + sin(2 * $pi * vph) * 0.007 * m5 * vt * vt);\nsf < 48 ? sf *= 2;\nenv = env_adsr(0, gate, 0.001, 0.2, 1, 0.12);\n// feedback: harmonic h of the clean string, isolated by two band-passes,\n// soft-limited and fed back in; the fundamental is left to decay\nh = m3 < 0.25 ? 2 : m3 < 0.5 ? 3 : m3 < 0.75 ? 4 : 5;\nch = log(sf * h / 20) * k;\nhb = flt_bp(1, flt_bp(0, s, ch, 0.7), ch, 0.7) * 0.025;\nfbin = fx_sat(hb * m1 * m1 * 2.5, 0.5) * 0.25 * env;\ns = phys_string(0, ex + fbin, sf, 0.35 + m2 * 0.6, 0.8);\n// the amp: pre-gain into tanh\na = fx_sat(s * (2 + m4 * 5), 0.45 + m4 * 0.45);\nout = a * env;",
    "master": "// amp and cab: tighten below ~56 Hz, a second gain stage, 5 kHz roll-off + 900 Hz bump\nx = flt_hp(0, inl, 0.15, 0.1);\nx = fx_sat(x * (1 + m4 * 3), 0.3 + m4 * 0.5);\nx = flt_lp(0, x, 0.8, 0.3) + flt_bp(0, x, 0.55, 0.5) * 0.35;\ncl = bus_chorus(x, x, 0.2, 0.25);\ncr = bus_chorus_r();\noutl = bus_reverb(cl, cr, 0.6, m6 * 0.4);\noutr = bus_reverb_r();"
  },
  "trim": 0.612544
}
