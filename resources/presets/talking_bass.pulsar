      "label": "Talk Rate",
      "default": 0.6
    },
    {
      "label": "Talk Depth",
      "default": 0.45
    },
    {
      "label": "Growl",
      "default": 0.45
    },
    {
      "label": "Detune",
      "default": 0.4
    },
    {
      "label": "Sub",
      "default": 0.6
    },
    {
      "label": "Drive",
      "default": 0.5
    }
  ],
  "voiceMode": "mono",
