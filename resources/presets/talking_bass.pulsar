{
  "version": 1,
  "name": "Talking Bass",
  "prompt": "neuro reese that talks: three vowel formants sweep over a driven reese, and the formant output growls back into the reese's own pitch",
  "macros": [
    {
      "label": "Talk",
      "default": 0.25
    },
