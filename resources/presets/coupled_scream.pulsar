{
  "version": 1,
  "name": "Coupled Scream",
  "prompt": "two oscillators that frequency-modulate each other through filters, one sample apart; the coupling goes from a clean tone to a screaming chaotic howl",
  "macros": [
    {
      "label": "Coupling",
      "default": 0.3
    },
    {
      "label": "Loop Tone",
      "default": 0.45
    },
    {
      "label": "Loop Res",
      "default": 0.3
    },
    {
      "label": "Ratio",
      "default": 0.5
    },
    {
      "label": "Bite",
      "default": 0.5
    },
    {
      "label": "Drive",
      "default": 0.45
    },
    {
      "label": "Space",
      "default": 0.25
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "osc_a",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "util_safe_fb:0"
      ],
      [
        "util_safe_fb:0",
        "osc_b"
      ],
      [
        "osc_b",
        "flt_lp:1"
      ],
      [
        "flt_lp:1",
        "util_safe_fb:1"
      ],
      [
        "util_safe_fb:1",
        "osc_a"
      ],
      [
        "env_adsr:1",
        "osc_a"
      ],
      [
        "osc_a",
        "out"
      ],
      [
        "osc_b",
        "out"
      ],
      [
        "env_adsr:0",
        "out"
      ]
    ]
  },
  "code": {
    "init": "// each note starts with the loop at rest\nfb1 = 0; fb2 = 0;",
    "voice": "// partner ratio: 1:1 beating, 3:2, 2:1, 3:1, 1:2\nr = m4 < 0.2 ? 1.003 : m4 < 0.4 ? 1.5 : m4 < 0.6 ? 2.002 : m4 < 0.8 ? 3.001 : 0.5;\nenv = env_adsr(0, gate, 0.003, 0.5, 0.85, 0.15);\n// coupling: the hero macro (chaos sets in near 2 rad; 3 is a pitched howl),\n// plus a burst on every note-on (Bite)\ncpl = m1 * sqrt(m1) * 3 + env_adsr(1, gate, 0.001, 0.14, 0, 0.1) * m5 * 2.5;\n// two phase oscillators, each phase-modulated by the other's last filtered sample\nph1 += freq / srate; ph1 -= floor(ph1);\nph2 += freq * r / srate; ph2 -= floor(ph2);\ny1 = sin(2 * $pi * ph1 + cpl * fb2);\ny2 = sin(2 * $pi * ph2 + cpl * fb1 * 1.3);\n// the loop filters colour the scream; safe_fb keeps it bounded\ntone = 0.3 + m2 * 0.65;\nfb1 = util_safe_fb(0, flt_lp(0, y1, tone, m3 * 0.85));\nfb2 = util_safe_fb(1, flt_lp(1, y2, tone, m3 * 0.85));\ny = y1 * 0.6 + y2 * 0.4;\n// DC trap (~3 Hz): heavy phase modulation drifts\ndc += (y - dc) * 20 / srate;\nout = (y - dc) * env * (0.6 + 0.4 * vel);",
    "master": "// amp: pre-gain into tanh, a cab roll-off, then chorus width and a room\nx = fx_sat(inl * (1 + m6 * 5), 0.25 + m6 * 0.7);\nx = flt_lp(0, x, 0.84, 0.2);\ncl = bus_chorus(x, x, 0.3, 0.3);\ncr = bus_chorus_r();\noutl = bus_reverb(cl, cr, 0.45, m7 * 0.35);\noutr = bus_reverb_r();"
  },
  "trim": 0.810416
}
