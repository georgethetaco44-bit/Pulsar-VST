{
  "version": 1,
  "name": "Boing Bass",
  "prompt": "rubber cartoon bass: every note kicks a damped mass-spring simulated per sample, so the pitch boings past the note and wobbles back, while a squelchy resonant filter opens with the spring's speed; Bounce sets stiffness and kick size, Damping how long it wobbles",
  "macros": [
    {
      "label": "Bounce",
      "default": 0.5
    },
    {
      "label": "Damping",
      "default": 0.3
    },
    {
      "label": "Squelch",
      "default": 0.6
    },
    {
      "label": "Shape",
      "default": 0.4
    },
    {
      "label": "Sub",
      "default": 0.9
    },
    {
      "label": "Squash",
      "default": 0.6
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "spring",
        "osc_square:0"
      ],
      [
        "spring",
        "osc_saw:0"
      ],
      [
        "osc_square:0",
        "flt_lp:0"
      ],
      [
        "osc_saw:0",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "flt_hp:0"
      ],
      [
        "flt_hp:0",
        "fx_ott:0"
      ],
      [
        "fx_ott:0",
        "out"
      ],
      [
        "osc_sine:0",
        "out"
      ]
    ]
  },
  "code": {
    "init": "// each note kicks the spring: the pitch starts below the note and springs past it\nkick = 4 + m1 * 14; sx = -kick; sv = 0;",
    "voice": "// damped mass-spring in semitones, semi-implicit Euler per sample\nw = 2 * $pi * (3 + m1 * 11);\nz = 0.04 + m2 * 0.5;\nsv += (-w * w * sx - 2 * z * w * sv) / srate;\nsx += sv / srate;\nf = freq * exp(sx * 0.0577623);\n// squelch opens with the spring's speed\nsq = min(1, abs(sv) / (w * kick + 1) * 1.5);\nfe = env_adsr(1, gate, 0.001, 0.15, 0.2, 0.05);\nx = osc_square(0, f, 0.5 - m4 * 0.35) * 0.6 + osc_saw(0, f * 1.005) * 0.45;\ny = flt_lp(0, x, min(0.95, 0.28 + m3 * 0.15 + sq * m3 * 0.45 + fe * 0.2), 0.55 + m3 * 0.35);\n// mid band only: drive, clear the low mids, OTT after the drive, fixed ceiling\ny = flt_hp(1, fx_sat(y * 2, 0.5), 0.27, 0);\ny = fx_sat(fx_ott(0, y, m6 * 0.8), 0.4);\n// the sub boings too, but it stays a clean sine added last\nenv = env_adsr(0, gate, 0.001, 0.3, 0.8, 0.35);\nout = (osc_sine(0, f) * m5 * 0.5 + y * 0.6) * env;",
    "master": "// width: a delayed copy of the band above 100 Hz goes to the sides only\n// (L = in + d, R = in - d). The mono sum is the voice untouched (no band\n// split on the main path), and the low end stays mono.\nlo = util_xover_lo(0, inl);\nhi = util_xover_hi(0);\n!ready ? (ready = 1; dn = floor(srate * 0.0011));\nmem[hw] = hi; hw = (hw + 1) % 4096;\nd = mem[(hw - dn + 4096) % 4096] * 0.3;\noutl = inl + d;\noutr = inl - d;"
  },
  "trim": 0.657787
}
