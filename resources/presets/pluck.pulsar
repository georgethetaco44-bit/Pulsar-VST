{
  "version": 1,
  "name": "Pluck",
  "prompt": "short bright pluck with a decaying filter and a little chorus",
  "macros": [
    {
      "label": "Cutoff",
      "default": 0.45
    },
    {
      "label": "Decay",
      "default": 0.4
    },
    {
      "label": "Resonance",
      "default": 0.3
    },
    {
      "label": "Chorus",
      "default": 0.5
    },
    {
      "label": "Squash",
      "default": 0.5
    }
  ],
  "voiceMode": "poly",
  "graph": {
    "edges": [
      [
        "osc_saw:0",
        "flt_lp:0"
      ],
      [
        "osc_square:0",
        "flt_lp:0"
      ],
      [
        "env_adsr:1",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "out"
      ],
      [
        "env_adsr:0",
        "out"
      ],
      [
        "out",
        "bus_chorus"
      ]
    ]
  },
  "code": {
    "init": "",
    "voice": "// amp and filter envelopes, both zero-sustain\nenv = env_adsr(0, gate, 0, 0.55 + m2 * 0.15, 0, 0.45);\nfenv = env_adsr(1, gate, 0, 0.45 + m2 * 0.15, 0, 0.4);\n// saw + slightly detuned square, a sine underneath for body\nx = osc_saw(0, freq) * 0.6 + osc_square(0, freq * 1.005, 0.5) * 0.4 + osc_sine(0, freq) * 0.35;\n// the filter envelope does the pluck\ny = flt_lp(0, x, 0.15 + m1 * 0.35 + fenv * 0.45, m3 * 0.8);\nout = fx_sat(y * 1.5, 0.25) * env * vel;",
    "master": "// chorus for width, a multiband squash brings the decays forward, then glue\ncl = bus_chorus(inl, inr, 0.3, m4 * 0.5);\ncr = bus_chorus_r();\noutl = bus_sat(fx_ott(0, cl, m5), 0.25) * 1.3;\noutr = bus_sat(fx_ott(1, cr, m5), 0.25) * 1.3;"
  },
  "trim": 0.766614
}
