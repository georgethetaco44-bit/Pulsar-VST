  "code": {
    "init": "last = -1;",
    "voice": "env = env_adsr(0, gate, 0.001, 0.3, 0.9, 0.04);\n// one decision per 1/16 from a hash of the step (the master computes the same)\ns = floor(beat * 4);\ns != last ? (\n  last = s; t0 = 0;\n  h1 = sin(s * 12.9898) * 43758.5453; h1 -= floor(h1);\n  h2 = sin(s * 78.233) * 12543.123; h2 -= floor(h2);\n  h3 = sin(s * 37.719) * 9631.71; h3 -= floor(h3);\n  chop = h1 < m1;\n  ne = chop ? floor(h2 * 3) : 0;\n  ramp = chop && h3 < 0.45 ? (h3 < 0.22 ? 1 : -1) : 0;\n  rep = chop && h3 >= 0.45 && h3 < 0.45 + m3 * 0.55;\n  sn = srate * 15 / bpm;\n  rl = floor(sn / (h2 < 0.5 ? 4 : 2));\n  anc = (wp - rl + 8192) % 8192;\n  ed = srate * 0.0003;\n);\n// pitch ramp across the step: up or down an octave times Ramp\npr = ramp * m2 * 12 * min(1, t0 / sn);\nf = freq * exp(pr * 0.0577623);\n// three engines, always running so their phases stay continuous; the step's\n// engine is armed on the 1/16 and spliced in at the reference's next upward\n// zero-crossing (the phase wrap), so the switch never lands mid-cycle\nph += f / srate;\nph >= 1 ? (ph -= floor(ph); eng = ne);\na = sin(2 * $pi * ph + sin(4 * $pi * ph) * (1.2 + m4 * 1.5));\nb = fx_fold(osc_saw(0, f) * 1.4, 0.3 + m4 * 0.5);\nc = fx_crush(0, osc_square(0, f * 2, 0.3) * 0.7, 0.25 + m4 * 0.4, 0.55);\n// 0.3 ms slews between engines\nga = eng == 0 ? min(1, ga + 1 / ed) : max(0, ga - 1 / ed);\ngb = eng == 1 ? min(1, gb + 1 / ed) : max(0, gb - 1 / ed);\ngc = eng == 2 ? min(1, gc + 1 / ed) : max(0, gc - 1 / ed);\nx = a * ga + b * gb + c * gc;\n// slice repeats from a ring of the live signal in mem[0..8191]: they replace it\nmem[wp] = x; wp = (wp + 1) % 8192;\nrep ? (\n  kk = t0 % rl;\n  rs = mem[(anc + kk) % 8192] * max(0, min(1, min(kk, rl - ed - kk) / ed));\n  lv = max(0, lv - 1 / ed);\n) : (\n  rs = 0; lv = min(1, lv + 1 / ed);\n);\nx = x * lv + rs;\nt0 += 1;\nx = fx_sat(x * 1.5, 0.4 + m4 * 0.3);\nx = fx_ott(0, flt_hp(0, x, 0.247, 0), 0.7);\n// the clean sub ignores the edits\nout = (osc_sine(0, freq) * m5 * 0.9 + x * 0.85) * env;",
    "master": "!ready ? (\n  ready = 1; hd = 0; dn = floor(srate * 0.0008); last = -1;\n  // LR4 crossover at 150 Hz: two Butterworth biquads per side\n  w0 = 2 * $pi * 150 / srate; cw = cos(w0); al = sin(w0) / 1.41421356; a0 = 1 + al;\n  lb0 = (1 - cw) / 2 / a0; lb1 = (1 - cw) / a0;\n  hb0 = (1 + cw) / 2 / a0; hb1 = -(1 + cw) / a0;\n  c1 = -2 * cw / a0; c2 = (1 - al) / a0;\n);\n// split-brain: lo (the clean sub) passes untouched and mono\nl1 = lb0 * inl + z1; z1 = lb1 * inl - c1 * l1 + z2; z2 = lb0 * inl - c2 * l1;\nlo = lb0 * l1 + z3; z3 = lb1 * l1 - c1 * lo + z4; z4 = lb0 * l1 - c2 * lo;\nh1 = hb0 * inl + z5; z5 = hb1 * inl - c1 * h1 + z6; z6 = hb0 * inl - c2 * h1;\nhi = hb0 * h1 + z7; z7 = hb1 * h1 - c1 * hi + z8; z8 = hb0 * h1 - c2 * hi;\n// stereo pings: the same hash as the voice; edited steps jump left or right\ns = floor(beat * 4);\ns != last ? (\n  last = s;\n  h1 = sin(s * 12.9898) * 43758.5453; h1 -= floor(h1);\n  h2 = sin(s * 78.233) * 12543.123; h2 -= floor(h2);\n  pt = h1 < m1 ? (h2 < 0.5 ? -1 : 1) * m6 * 0.7 : 0;\n  ps = 1 / (srate * 0.0003);\n);\npn = pt > pn ? min(pt, pn + ps) : max(pt, pn - ps);\nwg = m6 * 0.5;\n// width on the mid/high band only: a mid/side comb (L + R stays mono-safe)\nhd[hw] = hi; hw = (hw + 1) % 4096;\ndly = hd[(hw - dn + 4096) % 4096] * wg;\nhl = hi + dly; hr = hi - dly;\nhl *= 1 - pn; hr *= 1 + pn;\n// resample-style: drive and squash the mid/high band\nhl = fx_ott(0, bus_sat(hl, 0.35), m7);\nhr = fx_ott(1, bus_sat(hr, 0.35), m7);\n// then clip it into the headroom the sub leaves at this sample, so the sum\n// stays under 1 while the sub itself is never touched\nhm = max(0.15, 1 - abs(lo));\nyl = hm * bus_sat(hl * 1.6 / hm, 0); yr = hm * bus_sat(hr * 1.6 / hm, 0);\n// ~10 Hz DC trap: clipping an asymmetric wave leaves an offset\ndl += (yl - dl) * 60 / srate; dr += (yr - dr) * 60 / srate;\noutl = yl - dl + lo;\noutr = yr - dr + lo;"
  },
  "trim": 0.63799
}
