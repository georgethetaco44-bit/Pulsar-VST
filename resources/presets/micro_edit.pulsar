{
  "version": 1,
  "name": "Micro Edit",
  "prompt": "glitch micro-edit bass: every 1/16 a hashed pattern switches between an FM growl, a folded saw and a crushed square (spliced on zero-crossings), adds pitch ramps and repeats slices, all with 0.3 ms edges, while the master pings the edits left and right; Glitch goes from steady to fully chopped",
  "macros": [
    {
      "label": "Glitch",
      "default": 0.5
    },
    {
      "label": "Ramp",
      "default": 0.6
    },
    {
      "label": "Repeat",
      "default": 0.5
    },
    {
      "label": "Grit",
      "default": 0.45
    },
    {
      "label": "Sub",
      "default": 0.9
    },
    {
      "label": "Width",
      "default": 0.6
    },
    {
      "label": "Squash",
      "default": 0.6
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "fm_growl",
        "edit"
      ],
      [
        "osc_saw:0",
        "edit"
      ],
      [
        "fx_crush:0",
        "edit"
      ],
      [
        "edit",
        "slice_ring"
      ],
      [
        "slice_ring",
        "flt_hp:0"
      ],
      [
        "flt_hp:0",
        "fx_ott:0"
      ],
      [
        "fx_ott:0",
        "out"
      ],
      [
        "osc_sine:0",
        "out"
      ]
    ]
  },
  "code": {
    "init": "last = -1;",
    "voice": "env = env_adsr(0, gate, 0.001, 0.3, 0.9, 0.35);\n// one decision per 1/16 from a hash of the step (the master computes the same)\ns = floor(beat * 4);\ns != last ? (\n  last = s; t0 = 0;\n  h1 = sin(s * 12.9898) * 43758.5453; h1 -= floor(h1);\n  h2 = sin(s * 78.233) * 12543.123; h2 -= floor(h2);\n  h3 = sin(s * 37.719) * 9631.71; h3 -= floor(h3);\n  chop = h1 < m1;\n  ne = chop ? floor(h2 * 3) : 0;\n  ramp = chop && h3 < 0.45 ? (h3 < 0.22 ? 1 : -1) : 0;\n  rep = chop && h3 >= 0.45 && h3 < 0.45 + m3 * 0.55;\n  sn = srate * 15 / bpm;\n  rl = floor(sn / (h2 < 0.5 ? 4 : 2));\n  anc = (wp - rl + 8192) % 8192;\n  ed = srate * 0.0003;\n);\n// pitch ramp across the step: up or down an octave times Ramp\nf = freq * exp(ramp * m2 * 12 * min(1, t0 / sn) * 0.0577623);\n// three engines, always running so their phases stay continuous; the step's\n// engine is armed on the 1/16 and spliced in at the next phase wrap\nph += f / srate;\nph >= 1 ? (ph -= floor(ph); eng = ne);\na = sin(2 * $pi * ph + sin(4 * $pi * ph) * (1.2 + m4 * 1.5));\nb = fx_fold(osc_saw(0, f) * 1.4, 0.3 + m4 * 0.5);\nc = fx_crush(0, osc_square(0, f * 2, 0.3) * 0.7, 0.25 + m4 * 0.4, 0.55);\n// 0.3 ms slews between engines\nga = eng == 0 ? min(1, ga + 1 / ed) : max(0, ga - 1 / ed);\ngb = eng == 1 ? min(1, gb + 1 / ed) : max(0, gb - 1 / ed);\ngc = eng == 2 ? min(1, gc + 1 / ed) : max(0, gc - 1 / ed);\nx = a * ga + b * gb + c * gc;\n// slice repeats from a ring of the live signal in mem[0..8191]: they replace it\nmem[wp] = x; wp = (wp + 1) % 8192;\nrep ? (\n  kk = t0 % rl;\n  rs = mem[(anc + kk) % 8192] * max(0, min(1, min(kk, rl - ed - kk) / ed));\n  lv = max(0, lv - 1 / ed);\n) : (\n  rs = 0; lv = min(1, lv + 1 / ed);\n);\nx = x * lv + rs;\nt0 += 1;\n// mid band only: drive, clear the low mids, OTT after the drive, fixed ceiling\nx = flt_hp(0, fx_sat(x * 1.5, 0.4 + m4 * 0.3), 0.27, 0);\nx = fx_sat(fx_ott(0, x, m7 * 0.8), 0.4);\n// the clean sub ignores the edits and joins last\nout = (osc_sine(0, freq) * m5 * 0.5 + x * 0.6) * env;",
    "master": "// the high band (above 100 Hz) feeds the width and the pings only\nlo = util_xover_lo(0, inl);\nhi = util_xover_hi(0);\n!ready ? (ready = 1; dn = floor(srate * 0.0008); last = -1);\n// stereo pings: the same hash as the voice; edited steps jump left or right\ns = floor(beat * 4);\ns != last ? (\n  last = s;\n  h1 = sin(s * 12.9898) * 43758.5453; h1 -= floor(h1);\n  h2 = sin(s * 78.233) * 12543.123; h2 -= floor(h2);\n  pt = h1 < m1 ? (h2 < 0.5 ? -1 : 1) * m6 * 0.7 : 0;\n  ps = 1 / (srate * 0.0003);\n);\npn = pt > pn ? min(pt, pn + ps) : max(pt, pn - ps);\n// width: a delayed copy of the high band to the sides only, then the pings\n// turn the high band down on the far side; the main path is never split\nmem[hw] = hi; hw = (hw + 1) % 4096;\nd = mem[(hw - dn + 4096) % 4096] * m6 * 0.4;\noutl = inl + d - hi * max(0, pn);\noutr = inl - d + hi * min(0, pn);"
  },
  "trim": 0.572085
}
