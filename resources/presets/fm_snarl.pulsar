{
  "version": 1,
  "name": "FM Snarl",
  "prompt": "dirty FM bass where the sine feeds back into itself, smooth at the bottom of the knob and snarling at the top",
  "macros": [
    {
      "label": "Feedback",
      "default": 0.4
    },
    {
      "label": "Cutoff",
      "default": 0.55
    },
    {
      "label": "Resonance",
      "default": 0.3
    },
    {
      "label": "Fold",
      "default": 0.35
    },
    {
      "label": "Body",
      "default": 0.5
    },
    {
      "label": "Env > FB",
      "default": 0.5
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "osc_sine:0",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "fx_fold"
      ],
      [
        "fx_fold",
        "util_safe_fb:0"
      ],
      [
        "util_safe_fb:0",
        "osc_sine:0"
      ],
      [
        "fx_fold",
        "out"
      ],
      [
        "osc_tri:0",
        "out"
      ],
      [
        "out",
        "bus_sat"
      ]
    ]
  },
  "code": {
    "init": "// each note starts with no feedback\nfb1 = 0;",
    "voice": "// amp envelope; it also scales the feedback for a snarly attack\nenv = env_adsr(0, gate, 0.05, 0.4, 0.8, 0.3);\nk = m1 * (1 - m6 + m6 * env) * 4;\n// last sample's output bends this sample's pitch: feedback FM\nx = osc_sine(0, freq * (1 + fb1 * k));\n// lowpass, then fold\ny = fx_fold(flt_lp(0, x, 0.3 + m2 * 0.6, m3 * 0.8), m4);\n// back through the safety stage for the next sample\nfb1 = util_safe_fb(0, y);\n// DC trap: feedback FM bends the wave asymmetric\ndc += (y - dc) * 20 / srate;\ny -= dc;\n// crossfade in a steady triangle body (level stays put)\nout = (y * (1 - m5 * 0.5) + osc_tri(0, freq) * m5 * 0.5) * env * 0.6;",
    "master": "// glue; bus_sat at drive 0.3 also caps the chaotic feedback peaks at 0.69\noutl = bus_sat(inl, 0.3);\noutr = bus_sat(inr, 0.3);"
  },
  "trim": 1.0
}
