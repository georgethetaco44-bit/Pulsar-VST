{
  "version": 1,
  "name": "Bloom Pulse",
  "prompt": "evolving ambient drone that blooms over 30 seconds with shimmer",
  "macros": [
    {
      "label": "Bloom",
      "default": 1.0
    },
    {
      "label": "Shimmer",
      "default": 0.96
    },
    {
      "label": "Vowel",
      "default": 0.013333
    },
    {
      "label": "Drift",
      "default": 0.0
    },
    {
      "label": "Glow",
      "default": 0.3
    },
    {
      "label": "Motion",
      "default": 0.246667
    },
    {
      "label": "Attack",
      "default": 0.6
    },
    {
      "label": "Space",
      "default": 0.5
    }
  ],
  "voiceMode": "poly",
  "graph": {
    "edges": [
      [
        "osc_wt:0",
        "flt_formant:0"
      ],
      [
        "flt_formant:0",
        "fx_sat"
      ],
      [
        "osc_sine:1",
        "out"
      ],
      [
        "flt_formant:0",
        "out"
      ],
      [
        "out",
        "bus_reverb"
      ]
    ]
  },
  "code": {
    "init": "g = 1;\nbloom = 0;\ndt = 1 / (30 * srate);",
    "voice": "bloom = min(bloom + dt, 1);\nper = m6 < 0.33 ? 2.0 : m6 < 0.66 ? 1.0 : 0.5;\ninvPer = m6 < 0.33 ? 0.5 : m6 < 0.66 ? 1.0 : 2.0;\nsq = mod_lfo(0, per, 0.3 + m6 * 0.4);\nseq = sq - 0.5;\npos = 0.15 + bloom * (0.25 + m1 * 0.5) + m4 * 0.15 + seq * (0.1 + m1 * 0.35);\na = osc_wt(0, freq, 7, pos);\nvw = m3 * 0.6 + bloom * (0.2 + m1 * 0.4) + seq * (0.25 + m1 * 0.55);\nx = flt_formant(0, a, vw, 0.65);\nx = fx_sat(x, 0.15 + m5 * 0.6 + m1 * 0.3);\nshimAmt = m2 * 0.8 + (m1 + bloom) * 0.5;\ns1 = osc_sine(0, freq * 4) * shimAmt * (0.1 + 0.12 * sq);\nbp = beat * invPer;\nph = bp - floor(bp);\ntgt = ph < 0.65 ? 1 : 1 - m1 * 0.75;\ng += (tgt - g) * 0.04;\nenv = env_adsr(0, gate, 0.55 + m7 * 0.3, 0.5, 0.9, 0.65);\nout = (x * 0.75 + s1) * env * g;",
    "master": "c = bus_chorus(inl, inr, 0.4, 0.25);\ncr = bus_chorus_r();\nr = bus_reverb(c, cr, 0.72, 0.1 + m8 * 0.3);\nrr = bus_reverb_r();\noutl = bus_width(r, rr, 0.8);\noutr = bus_width_r();"
  },
  "trim": 1.0
}
