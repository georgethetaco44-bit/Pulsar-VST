{
  "version": 1,
  "name": "Metal Neuro",
  "prompt": "hollow metallic neurofunk bass, comb filtered, gets crunchier the harder I hit the keys",
  "macros": [
    {
      "label": "Comb Ratio",
      "default": 0.35
    },
    {
      "label": "Comb FB",
      "default": 0.6
    },
    {
      "label": "Crush",
      "default": 0.7
    },
    {
      "label": "Downsample",
      "default": 0.2
    },
    {
      "label": "Cutoff",
      "default": 0.55
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "osc_saw:0",
        "fx_comb:0"
      ],
      [
        "osc_square:0",
        "fx_comb:0"
      ],
      [
        "fx_comb:0",
        "fx_crush:0"
      ],
      [
        "fx_crush:0",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "out"
      ],
      [
        "env_adsr:0",
        "out"
      ],
      [
        "out",
        "bus_sat"
      ]
    ]
  },
  "code": {
    "init": "",
    "voice": "// amp envelope\nenv = env_adsr(0, gate, 0.1, 0.4, 0.85, 0.35);\n// saw + slightly detuned square core\nx = osc_saw(0, freq) + osc_square(0, freq * 1.006, 0.5) * 0.7;\n// comb at a multiple of the note: the hollow metallic ring\nc = fx_comb(0, x * 0.4, freq * (1 + m1 * 3), 0.5 + m2 * 0.35);\n// bit crush (audible from ~0.5); velocity pushes it harder\ny = fx_crush(0, c, m3 * (0.6 + 0.3 * vel), 1 - m4 * 0.6);\n// lowpass tames the aliasing\ny = flt_lp(0, y, 0.45 + m5 * 0.45, 0.25);\nout = y * env * 0.5;",
    "master": "// glue; bus_sat at drive 0.3 also caps the crushed peaks at 0.69\noutl = bus_sat(inl, 0.3);\noutr = bus_sat(inr, 0.3);"
  },
  "trim": 1.0
}
