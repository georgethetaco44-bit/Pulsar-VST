{
  "version": 1,
  "name": "Scalpel Neuro",
  "prompt": "surgical neuro mid-bass for 174 drum and bass: an FM and saw core driven and folded, then a comb whose pitch steps every 1/16 note (peaks or notches), squashed after the drive over a clean mono sine sub; Morph goes from clean to snarling",
  "macros": [
    {
      "label": "Morph",
      "default": 0.4
    },
    {
      "label": "Comb Steps",
      "default": 0.75
    },
    {
      "label": "FM",
      "default": 0.45
    },
    {
      "label": "Squash",
      "default": 0.6
    },
    {
      "label": "Sub",
      "default": 0.9
    },
    {
      "label": "Width",
      "default": 0.5
    },
    {
      "label": "Tone",
      "default": 0.6
    },
    {
      "label": "Notch",
      "default": 0.0
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "fm_core",
        "fx_fold"
      ],
      [
        "osc_saw:0",
        "fx_fold"
      ],
      [
        "fx_fold",
        "fx_comb:0"
      ],
      [
        "fx_comb:0",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "flt_hp:1"
      ],
      [
        "flt_hp:1",
        "fx_ott:0"
      ],
      [
        "fx_ott:0",
        "out"
      ],
      [
        "osc_sine:0",
        "out"
      ]
    ]
  },
  "code": {
    "init": "// each note: the comb starts an octave up, ~1.5 ms glides between steps\ncr = 2; sl = 1 - exp(-1 / (0.0015 * srate));",
    "voice": "env = env_adsr(0, gate, 0.002, 0.4, 0.85, 0.3);\nfe = env_adsr(1, gate, 0.001, 0.12, 0, 0.05);\n// core: 2-op FM (modulator at 2x) plus a saw a hair sharp\nph += freq / srate; ph -= floor(ph);\nx = sin(2 * $pi * ph + sin(4 * $pi * ph) * (0.4 + m3 * 2.6)) * 0.6 + osc_saw(0, freq * 1.003) * 0.5;\n// stage 1, Morph: drive, then fold the driven signal\nx = fx_fold(fx_sat(x, 0.2 + m1 * 0.6), 0.05 + m1 * 0.5);\n// stage 2: the comb's pitch steps every 1/16 (ratios to the note); Notch flips peaks to notches\nst = floor(beat * 4) % 8;\ntg = st == 0 ? 2 : st == 1 ? 4 : st == 2 ? 3 : st == 3 ? 6 : st == 4 ? 2 : st == 5 ? 8 : st == 6 ? 1.5 : 5;\ncr += (2 + (tg - 2) * m2 - cr) * sl;\nx = x + fx_comb(0, x, freq * cr, 0.35 + m1 * 0.5) * (0.6 - m8 * 1.2);\n// tone, clear the low mids, OTT after the drive, fixed ceiling\nx = flt_lp(0, x, min(0.97, 0.45 + m7 * 0.4 + fe * 0.15), 0.25);\nx = fx_sat(fx_ott(0, flt_hp(1, x, 0.27, 0), m4), 0.45);\n// the clean sub joins last, at a fixed level\nout = (osc_sine(0, freq) * m5 * 0.5 + x * 0.6) * env;",
    "master": "// width: a delayed copy of the band above 100 Hz goes to the sides only\n// (L = in + d, R = in - d). The mono sum is the voice untouched (no band\n// split on the main path), and the low end stays mono.\nlo = util_xover_lo(0, inl);\nhi = util_xover_hi(0);\n!ready ? (ready = 1; dn = floor(srate * 0.0009));\nmem[hw] = hi; hw = (hw + 1) % 4096;\nd = mem[(hw - dn + 4096) % 4096] * m6 * 0.4;\noutl = inl + d;\noutr = inl - d;"
  },
  "trim": 0.589645
}
