  "code": {
    "init": "",
    "voice": "// short amp envelope and a faster filter blip\nenv = env_adsr(0, gate, 0.05, 0.5 + m3 * 0.15, 0.25, 0.45);\nblip = env_adsr(1, gate, 0, 0.3 + m2 * 0.2, 0, 0.3);\n// warm detuned stack\nx = osc_supersaw(0, freq, m1, 0.7);\n// lowpass blip; velocity opens it further\ny = flt_lp(0, x, 0.3 + m4 * 0.3 + blip * (0.2 + 0.2 * vel), m5 * 0.6);\nout = y * env * 1.6;",
    "master": "// chorus, then a small room\noutl = bus_chorus(inl, inr, 0.4, m6 * 0.5);\noutr = bus_chorus_r();\noutl = bus_reverb(outl, outr, 0.35, m7 * 0.5);\noutr = bus_reverb_r();"
  },
  "trim": 0.785974
