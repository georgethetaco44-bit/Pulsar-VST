  "code": {
    "init": "",
    "voice": "// saw + square a hair apart, a filter blip on each note, then drive\nenv = env_adsr(0, gate, 0.002, 0.3, 0.9, 0.08);\nfenv = env_adsr(1, gate, 0.001, 0.16, 0.2, 0.1);\nx = osc_saw(0, freq * 1.004) * 0.5 + osc_square(0, freq * 0.996, 0.5) * 0.45;\nx = flt_lp(0, x, min(0.95, 0.22 + m3 * 0.45 + fenv * 0.3), 0.35);\nx = fx_sat(x * 1.6, 0.4 + m4 * 0.5);\nout = (x * 0.75 + osc_sine(0, freq) * m5 * 0.7) * env;",
    "master": "// tape: a 1.35 s loop in mem[0..64999], written live, read by a head that can slow down\n!ready ? (ready = 1; n = 65000; spd = 1; gg = 1; lg = 1; last = -1);\ntape = 0;\ntape[w] = inl;\n// Tape Stop: head speed (1 - m1)^1.5 with a 15 ms glide; level follows speed like a deck\ntgt = 1 - m1; tgt *= sqrt(tgt);\nspd += (tgt - spd) * 0.0015;\nlag = w - r; lag < 0 ? lag += n;\n// back at speed but behind, or about to lap the tape: dip 5 ms, jump to live, come back\n((tgt > 0.999 && lag > 64) || lag > n - 256) ? sync = 1;\nsync ? (gg -= 0.004; gg <= 0 ? (gg = 0; r = w; sync = 0)) : gg = min(1, gg + 0.004);\nri = floor(r); fr = r - ri; i2 = ri + 1; i2 >= n ? i2 = 0;\ny = (tape[ri] + (tape[i2] - tape[ri]) * fr) * gg * spd ^ 0.6;\n// stutter: a 2-bar grid of 1/16 steps; each step's priority against Stutter decides\n// whether it loops the slice the head just played (1/32 or 1/64 long)\nstep = floor(beat * 4);\nstep != last ? (\n  last = step; k = 0; s = step - floor(step / 32) * 32;\n  p = (s == 15 || s == 31) ? 0.1 : (s % 8) == 6 ? 0.25 : s >= 28 ? 0.45 : (s % 4) == 3 ? 0.7 : (s % 2) ? 0.9 : 2;\n  rep = p < m2;\n  len = floor(srate * 60 / bpm * ((s >= 29 || p == 0.1 || p == 0.9) ? 0.0625 : 0.125));\n  sp = spd; anchor = r - len * sp; anchor < 0 ? anchor += n;\n);\nrep ? (\n  // replay the slice at the speed the head had when it was cut\n  kk = k % len; j = anchor + kk * sp; j >= n ? j -= n;\n  ji = floor(j); j2 = ji + 1; j2 >= n ? j2 = 0;\n  sy = tape[ji] + (tape[j2] - tape[ji]) * (j - ji);\n  // 1 ms fades at each repeat's ends; repeats alternate left/right\n  sy *= min(1, min(kk, len - kk) / 48) * sp ^ 0.6;\n  pan = ((floor(k / len) % 2) ? 1 : -1) * m6 * 0.6;\n  lg = max(0, lg - 1 / 48);\n) : (\n  // live again after a stutter: fade back in over 1 ms\n  sy = 0;\n  lg = min(1, lg + 1 / 48);\n);\nk += 1;\nw += 1; w >= n ? w = 0;\nr += spd; r >= n ? r -= n;\noutl = bus_sat(y * lg + sy * (1 - pan), 0.3 + m4 * 0.3);\noutr = bus_sat(y * lg + sy * (1 + pan), 0.3 + m4 * 0.3);"
  },
  "trim": 1.0
}
