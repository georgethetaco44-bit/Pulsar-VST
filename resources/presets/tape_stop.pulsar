{
  "version": 1,
  "name": "Tape Stop Bass",
  "prompt": "driven saw and square bass on a tape loop: the master records it and plays it back through a head that slows to a stop, with beat-synced stutter repeats",
  "macros": [
    {
      "label": "Tape Stop",
      "default": 0.0
    },
    {
      "label": "Stutter",
      "default": 0.35
    },
    {
      "label": "Cutoff",
      "default": 0.45
    },
    {
      "label": "Drive",
      "default": 0.5
    },
    {
      "label": "Sub",
      "default": 0.6
    },
    {
      "label": "Spread",
      "default": 0.5
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "osc_saw:0",
        "flt_lp:0"
      ],
      [
        "osc_square:0",
        "flt_lp:0"
      ],
      [
        "env_adsr:1",
        "flt_lp:0"
      ],
      [
        "flt_lp:0",
        "fx_sat"
      ],
