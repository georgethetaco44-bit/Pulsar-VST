  "code": {
    "init": "// vibrato fade-in restarts at every note\nvt = 0;",
    "voice": "// amp envelope\nenv = env_adsr(0, gate, 0.1, 0.4, 0.8, 0.35);\n// delayed vibrato: depth ramps up over ~0.5 s\nvt = min(1, vt + 2 / srate);\nf = freq * (1 + osc_sine(0, 5.5) * m3 * vt * 0.01);\n// saw plus a square an octave down\nx = osc_saw(0, f) + osc_square(0, f * 0.5, 0.5) * m4;\n// resonant lowpass into grit\ny = fx_sat(flt_lp(0, x, 0.45 + m1 * 0.45, m2 * 0.7), m5);\nout = y * env;",
    "master": "// a multiband squash and glue for presence, then a touch of room\ncl = bus_sat(fx_ott(0, inl, m7), 0.3) * 1.3;\ncr = bus_sat(fx_ott(1, inr, m7), 0.3) * 1.3;\noutl = bus_reverb(cl, cr, 0.4, m6 * 0.4);\noutr = bus_reverb_r();"
  },
  "trim": 0.801131
}
