  "code": {
    "init": "",
    "voice": "env = env_adsr(0, gate, 0.002, 0.5, 0.8, 0.08);\n// exciter: a quiet saw plus a noise click on each note\nkick = env_adsr(1, gate, 0.0005, 0.03, 0, 0.02);\nex = osc_saw(0, freq) * 0.25 + noise() * kick * 0.7;\n// metallic body an octave up; Metal = structure (harmonic -> bell)\nr = phys_resonator(0, ex, freq * 2, m2, 0.5 + m1 * 0.35, 0.45);\n// ring-mod carrier at Ring Ratio x the note, its phase kicked by audio-rate chaos\nlz = chaos_lorenz(0, 0.7 + m4 * 0.3, 0);\nrp += freq * (0.5 + m3 * 3) / srate; rp -= floor(rp);\ncar = sin(2 * $pi * rp + lz * (1 + m4 * 5) * m1);\nrm = min(1, m1 * 1.4);\ny = r * (1 - rm) + r * car * rm;\n// grind, a piece-wise transfer: the positive half folds through a sine, the\n// negative half is stair-stepped (Corrode drives harder into coarser steps)\ny *= 1.2 + m1 * 4;\nq = 40 - m1 * 34;\ny = y > 0 ? sin(min(y, 5)) : floor(max(y, -1.2) * q) / q;\n// then a little crush (only near the top of Corrode) and the squash\ny = fx_crush(0, y, m1 * m1 * 0.45, 1 - m1 * m1 * 0.55);\n// tone: ~5 kHz, opening to ~10 kHz at full Corrode\ny = flt_lp(0, y, 0.8 + m1 * 0.1, 0.1);\ny = fx_ott(0, flt_hp(0, y, 0.247, 0), m7);\nout = (osc_sine(0, freq) * m5 * 0.9 + y * 0.85) * env;",
    "master": "!ready ? (\n  ready = 1;\n  // LR4 crossover at 150 Hz: two Butterworth biquads per side\n  w0 = 2 * $pi * 150 / srate; cw = cos(w0); al = sin(w0) / 1.41421356; a0 = 1 + al;\n  lb0 = (1 - cw) / 2 / a0; lb1 = (1 - cw) / a0;\n  hb0 = (1 + cw) / 2 / a0; hb1 = -(1 + cw) / a0;\n  c1 = -2 * cw / a0; c2 = (1 - al) / a0;\n);\n// split-brain: lo (the clean sub) passes untouched and mono\nl1 = lb0 * inl + z1; z1 = lb1 * inl - c1 * l1 + z2; z2 = lb0 * inl - c2 * l1;\nlo = lb0 * l1 + z3; z3 = lb1 * l1 - c1 * lo + z4; z4 = lb0 * l1 - c2 * lo;\nh1 = hb0 * inl + z5; z5 = hb1 * inl - c1 * h1 + z6; z6 = hb0 * inl - c2 * h1;\nhi = hb0 * h1 + z7; z7 = hb1 * h1 - c1 * hi + z8; z8 = hb0 * h1 - c2 * hi;\n// metallic shimmer: chorus and a small room on the mid/high band only\nhl = bus_chorus(hi, hi, 0.35, 0.35);\nhr = bus_chorus_r();\nhl = bus_reverb(hl, hr, 0.35, m6 * 0.4);\nhr = bus_reverb_r();\n// resample-style: drive and squash the mid/high band\nhl = fx_ott(0, bus_sat(hl, 0.35), m7);\nhr = fx_ott(1, bus_sat(hr, 0.35), m7);\n// then clip it into the headroom the sub leaves at this sample, so the sum\n// stays under 1 while the sub itself is never touched\nhm = max(0.15, 1 - abs(lo));\nyl = hm * bus_sat(hl * 1.6 / hm, 0); yr = hm * bus_sat(hr * 1.6 / hm, 0);\n// ~10 Hz DC trap: clipping an asymmetric wave leaves an offset\ndl += (yl - dl) * 60 / srate; dr += (yr - dr) * 60 / srate;\noutl = yl - dl + lo;\noutr = yr - dr + lo;"
  },
  "trim": 0.64679
}
