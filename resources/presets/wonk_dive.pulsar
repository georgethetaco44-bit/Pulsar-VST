{
  "version": 1,
  "name": "Wonk Dive",
  "prompt": "halftime FM wonk bass at 140: a round FM bass that dives in pitch on every note, an FM-index envelope, a squelchy resonant ladder envelope and a glassy upper partial; short, dry and punchy, with Wonk adding bend-in, index and squelch",
  "macros": [
    {
      "label": "Wonk",
      "default": 0.45
    },
    {
      "label": "Dive",
      "default": 0.5
    },
    {
      "label": "Squelch",
      "default": 0.55
    },
    {
      "label": "Glass",
      "default": 0.4
    },
    {
      "label": "Sub",
      "default": 0.9
    },
    {
      "label": "Squash",
      "default": 0.6
    }
  ],
  "voiceMode": "mono",
  "graph": {
    "edges": [
      [
        "fm_core",
        "flt_ladder:0"
      ],
      [
        "glass",
        "flt_ladder:0"
      ],
      [
        "env_adsr:1",
        "flt_ladder:0"
      ],
      [
        "flt_ladder:0",
        "flt_hp:0"
      ],
      [
        "flt_hp:0",
        "fx_ott:0"
      ],
      [
        "fx_ott:0",
        "out"
      ],
      [
        "sub_sine",
        "out"
      ]
    ]
  },
  "code": {
    "init": "// each note: the dive, the bend-in and the FM index all restart\npe = 1; be = 1; ie = 1;\ndk = exp(-1 / (0.04 * srate)); bk = exp(-1 / (0.07 * srate)); ik = exp(-1 / (0.12 * srate));",
    "voice": "// pitch: Dive drops in from up to +14 st; Wonk bends up from up to -7 st\npe *= dk; be *= bk; ie *= ik;\nf = freq * exp((pe * m2 * 14 - be * m1 * 7) * 0.0577623);\nph += f / srate; ph -= floor(ph);\n// round FM: the modulator at 1x is also the sub; the index decays per note\nmd = sin(2 * $pi * ph);\nc = sin(2 * $pi * ph + md * (0.5 + ie * (1.2 + m1 * 3.5)));\n// glassy 6th partial, brightest at the attack\ngl = sin(12 * $pi * ph + md * 0.7) * m4 * (0.12 + ie * 0.4);\n// squelch: resonant ladder with a fast envelope (Wonk opens it wider)\nfe = env_adsr(1, gate, 0.001, 0.08 + m1 * 0.1, 0.12, 0.04);\ny = flt_ladder(0, c * 1.3 + gl, min(0.95, 0.22 + m3 * 0.2 + fe * (0.3 + m1 * 0.25)), 0.5 + m3 * 0.42);\n// mid band only: drive, clear the low mids, OTT after the drive, fixed ceiling\ny = flt_hp(0, fx_sat(y * 2, 0.45) + gl * 0.5, 0.27, 0);\ny = fx_sat(fx_ott(0, y, m6 * 0.8), 0.4);\n// short and dry: a 25 ms release keeps the halftime gaps silent\nenv = env_adsr(0, gate, 0.001, 0.35, 0.75, 0.35);\nout = (md * m5 * 0.5 + y * 0.6) * env;",
    "master": "// width: a delayed copy of the band above 100 Hz goes to the sides only\n// (L = in + d, R = in - d). The mono sum is the voice untouched (no band\n// split on the main path), and the low end stays mono.\nlo = util_xover_lo(0, inl);\nhi = util_xover_hi(0);\n!ready ? (ready = 1; dn = floor(srate * 0.0006));\nmem[hw] = hi; hw = (hw + 1) % 4096;\nd = mem[(hw - dn + 4096) % 4096] * 0.2;\noutl = inl + d;\noutr = inl - d;"
  },
  "trim": 0.634069
}
