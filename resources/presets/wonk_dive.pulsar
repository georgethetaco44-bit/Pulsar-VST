  "code": {
    "init": "// each note: the dive, the bend-in and the FM index all restart\npe = 1; be = 1; ie = 1;\ndk = exp(-1 / (0.04 * srate)); bk = exp(-1 / (0.07 * srate)); ik = exp(-1 / (0.12 * srate));",
    "voice": "// pitch: Dive drops in from up to +14 st; Wonk bends up from up to -7 st\npe *= dk; be *= bk; ie *= ik;\nf = freq * exp((pe * m2 * 14 - be * m1 * 7) * 0.0577623);\nph += f / srate; ph -= floor(ph);\n// round FM: modulator at 1x (it is also the clean sub), index decays per note\nmd = sin(2 * $pi * ph);\nc = sin(2 * $pi * ph + md * (0.5 + ie * (1.2 + m1 * 3.5)));\n// glassy 6th partial, brightest at the attack\ngl = sin(12 * $pi * ph + md * 0.7) * m4 * (0.12 + ie * 0.4);\n// squelch: resonant ladder with a fast envelope (Wonk opens it wider)\nfe = env_adsr(1, gate, 0.001, 0.08 + m1 * 0.1, 0.12, 0.04);\ny = flt_ladder(0, c * 1.3 + gl, min(0.95, 0.22 + m3 * 0.2 + fe * (0.3 + m1 * 0.25)), 0.5 + m3 * 0.4);\ny = fx_sat(y * 2, 0.45) + gl * 0.5;\ny = fx_ott(0, flt_hp(0, y, 0.247, 0), 0.75);\n// short and dry: 30 ms release keeps the halftime gaps silent\nenv = env_adsr(0, gate, 0.001, 0.35, 0.75, 0.03);\nout = (md * m5 * 0.9 + y * 0.85) * env;",
    "master": "!ready ? (\n  ready = 1; hd = 0; dn = floor(srate * 0.0006);\n  // LR4 crossover at 150 Hz: two Butterworth biquads per side\n  w0 = 2 * $pi * 150 / srate; cw = cos(w0); al = sin(w0) / 1.41421356; a0 = 1 + al;\n  lb0 = (1 - cw) / 2 / a0; lb1 = (1 - cw) / a0;\n  hb0 = (1 + cw) / 2 / a0; hb1 = -(1 + cw) / a0;\n  c1 = -2 * cw / a0; c2 = (1 - al) / a0;\n);\n// split-brain: lo (the clean sub) passes untouched and mono\nl1 = lb0 * inl + z1; z1 = lb1 * inl - c1 * l1 + z2; z2 = lb0 * inl - c2 * l1;\nlo = lb0 * l1 + z3; z3 = lb1 * l1 - c1 * lo + z4; z4 = lb0 * l1 - c2 * lo;\nh1 = hb0 * inl + z5; z5 = hb1 * inl - c1 * h1 + z6; z6 = hb0 * inl - c2 * h1;\nhi = hb0 * h1 + z7; z7 = hb1 * h1 - c1 * hi + z8; z8 = hb0 * h1 - c2 * hi;\nwg = 0.25;\n// width on the mid/high band only: a mid/side comb (L + R stays mono-safe)\nhd[hw] = hi; hw = (hw + 1) % 4096;\ndly = hd[(hw - dn + 4096) % 4096] * wg;\nhl = hi + dly; hr = hi - dly;\n// resample-style: drive and squash the mid/high band\nhl = fx_ott(0, bus_sat(hl, 0.35), m6);\nhr = fx_ott(1, bus_sat(hr, 0.35), m6);\n// then clip it into the headroom the sub leaves at this sample, so the sum\n// stays under 1 while the sub itself is never touched\nhm = max(0.15, 1 - abs(lo));\nyl = hm * bus_sat(hl * 1.6 / hm, 0); yr = hm * bus_sat(hr * 1.6 / hm, 0);\n// ~10 Hz DC trap: clipping an asymmetric wave leaves an offset\ndl += (yl - dl) * 60 / srate; dr += (yr - dr) * 60 / srate;\noutl = yl - dl + lo;\noutr = yr - dr + lo;"
  },
  "trim": 0.667746
}
