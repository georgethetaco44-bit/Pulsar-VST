  "code": {
    "init": "",
    "voice": "// slow swell\nenv = env_adsr(0, gate, 0.66 + m4 * 0.14, 0.6, 0.85, 0.72 + m5 * 0.12);\n// wide detuned stack\nx = osc_supersaw(0, freq, 0.35 + m1 * 0.5, 0.8);\n// slow sine LFO breathing on the cutoff\nlfo = osc_sine(0, 0.1 + m3 * 0.5);\ny = flt_lp(0, x, 0.32 + m2 * 0.4 + lfo * m3 * 0.06, 0.2);\nout = y * env * 1.8;",
    "master": "// chorus and a big space\noutl = bus_chorus(inl, inr, 0.6, 0.4);\noutr = bus_chorus_r();\noutl = bus_reverb(outl, outr, 0.8, m6 * 0.6);\noutr = bus_reverb_r();"
  },
  "trim": 0.869549
}
